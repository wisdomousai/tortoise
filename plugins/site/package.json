{
  "name": "@tortoise/site",
  "version": "0.1.0",
  "type": "module",
  "description": "Site host plugin: loads the site policy, enforces its profile floors and identity, and refuses compositions that would leave the policy unenforced.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/site"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/adapters": "workspace:*",
    "@tortoise/agents": "workspace:*",
    "@tortoise/bundle": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/runtime": "workspace:*",
    "jose": "6.2.12",
    "zod": "4.6.5"
  }
}
