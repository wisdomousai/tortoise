    "./plugin": "./src/expo/plugin.ts",
    "./managed-config": "./src/managed-config.ts",
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "dependencies": {
    "@agent-native/kernel": "workspace:*",
    "@agent-native/mobile": "workspace:*"
  },
