{
  "name": "@agent-native/managed-config",
  "version": "0.1.0",
  "type": "module",
  "description": "Managed configuration host plugin: settings pushed through device management (Android app restrictions, iOS managed app configuration) become plugin settings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/youtiger/agent-native-desktop-starter.git",
    "directory": "plugins/managed-config"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
