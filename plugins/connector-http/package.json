{
  "name": "@tortoise/connector-http",
  "version": "0.1.0",
  "type": "module",
  "description": "HTTP connector: a generic REST system of record through the network port, with an idempotency header, lookup by key, rejection mapping as data and a paged change list.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/connector-http"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/integration": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/runtime": "workspace:*"
  }
}
