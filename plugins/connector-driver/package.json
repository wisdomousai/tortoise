{
  "name": "@tortoise/connector-driver",
  "version": "0.1.0",
  "type": "module",
  "description": "Driver connector host plugin: hardware drivers in any language as supervised child processes speaking JSON-RPC over stdio, delivered to as outbox targets and observed as readings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/connector-driver"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugin-screens": "./src/plugin-screens.tsx",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tortoise/adapters": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/frame": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/integration": "workspace:*",
    "@tortoise/observation": "workspace:*",
    "@tortoise/process": "workspace:*",
    "@tortoise/runtime": "workspace:*",
    "@tortoise/testing": "workspace:*",
    "lucide-react": "1.52.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "19.3.0"
  }
}
