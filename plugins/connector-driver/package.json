{
  "name": "@agent-native/connector-driver",
  "version": "0.1.0",
  "type": "module",
  "description": "Driver connector host plugin: hardware drivers in any language as supervised child processes speaking JSON-RPC over stdio, delivered to as outbox targets and observed as readings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/agent-native-desktop-starter.git",
    "directory": "plugins/connector-driver"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugin-screens": "./src/plugin-screens.tsx",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@agent-native/adapters": "workspace:*",
    "@agent-native/contracts": "workspace:*",
    "@agent-native/frame": "workspace:*",
    "@agent-native/host": "workspace:*",
    "@agent-native/integration": "workspace:*",
    "@agent-native/observation": "workspace:*",
    "@agent-native/process": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@agent-native/testing": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "19.3.0"
  }
}
