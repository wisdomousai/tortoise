{
  "name": "@tortoise/connector-files",
  "version": "0.1.0",
  "type": "module",
  "description": "File exchange connector: a system of record reached through shared folders, with file-drop delivery, receipt or archive lookup and inbound sync from result exports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/connector-files"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/contracts": "workspace:*",
    "@tortoise/integration": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/runtime": "workspace:*"
  }
}
