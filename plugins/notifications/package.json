{
  "name": "@tortoise/notifications",
  "version": "0.1.0",
  "type": "module",
  "description": "Notifications host plugin: delivers outbox effects as local notifications through the OS plugin and runs the continuation a reply's single-use nonce stands for.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/notifications"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/integration": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/os": "workspace:*",
    "@tortoise/runtime": "workspace:*",
    "zod": "4.6.5"
  }
}
