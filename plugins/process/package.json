{
  "name": "@agent-native/process",
  "version": "0.1.0",
  "type": "module",
  "description": "Process host plugin: starts declared child processes from the site policy's executable bindings, with a built environment, pin checks, audit records and process-tree shutdown.",
  "repository": {
    "type": "git",
    "url": "https://github.com/youtiger/agent-native-desktop-starter.git",
    "directory": "plugins/process"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@agent-native/contracts": "workspace:*",
    "@agent-native/host": "workspace:*",
    "@agent-native/site": "workspace:*"
  }
}
