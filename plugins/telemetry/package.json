{
  "name": "@tortoise/telemetry",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenTelemetry metrics and traces from the audit log and the outbox, exported through the network guard without record contents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/telemetry"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "devDependencies": {
    "@tortoise/agents": "workspace:*",
    "@tortoise/network": "workspace:*",
    "@tortoise/runtime": "workspace:*",
    "@tortoise/deployment": "workspace:*",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@tortoise/audit": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/event-log": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/kernel": "workspace:*"
  }
}
