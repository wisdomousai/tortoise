{
  "name": "@agent-native/hub-link",
  "version": "0.1.0",
  "type": "module",
  "description": "Hub link host plugin: pairs a field device with an agent-native hub and gives the device a network port to it that carries the device credential.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/youtiger/agent-native-desktop-starter.git",
    "directory": "plugins/hub-link"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    "./contracts": "./src/contracts.ts",
    "./plugin-manifest": "./src/plugin-manifest.ts",
    "./plugin": "./src/plugin.ts",
    "./network": "./src/network.ts",
    "./pairing": "./src/pairing.ts",
    "./plugin-screens-native": "./src/expo/screens.tsx"
  },
  "dependencies": {
    "@agent-native/contracts": "workspace:*",
    "@agent-native/frame-native": "workspace:*",
    "@agent-native/kernel": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "lucide-react-native": "1.59.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-webview": "14.0.1"
  }
}
