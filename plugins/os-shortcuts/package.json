{
  "name": "@tortoise/os-shortcuts",
  "version": "0.1.0",
  "type": "module",
  "description": "OS shortcuts host plugin: serves shortcut handlers (dock menu, jump list, Android app shortcuts, web manifest shortcuts) for the OS plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/os-shortcuts"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/kernel": "workspace:*",
    "@tortoise/os": "workspace:*"
  }
}
