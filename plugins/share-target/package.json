{
  "name": "@tortoise/share-target",
  "version": "0.1.0",
  "type": "module",
  "description": "Share target host plugin: serves share handlers and share actions for the OS plugin, and holds web share target posts until the launch page session claims them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/share-target"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/contracts": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/os": "workspace:*",
    "@tortoise/runtime": "workspace:*",
    "@tortoise/shell": "workspace:*"
  }
}
