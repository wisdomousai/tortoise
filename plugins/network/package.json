{
  "name": "@tortoise/network",
  "version": "0.1.0",
  "type": "module",
  "description": "Network host plugin: the network guard and child proxy over the site policy's bindings, mutual TLS ingress, and default-deny OS and orchestrator rule exports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/network"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/adapters": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/site": "workspace:*"
  }
}
