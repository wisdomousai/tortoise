#!/usr/sbin/nft -f
# Generated by `tortoise network export --format nftables`. Do not edit; regenerate.
# Policy 7325a6cdf090f465 (sandbox, connected). Default: deny all outbound connections except loopback and the rules below.
# NOT ENFORCED: vendor-api (api.vendor.example) has no addresses in the site policy; it stays blocked here.
# Applies to sockets owned by user "tortoise"; other users are unaffected.
table inet tortoise {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid != "tortoise" accept
    oif "lo" accept
    ct state established,related accept
    ip daddr 10.20.0.53 udp dport 53 accept comment "dns"
    ip daddr 10.20.0.53 tcp dport 53 accept comment "dns"
    # audit-collector (plant, site): audit-collector for tests
    ip daddr 10.20.0.40/32 tcp dport 6514 accept comment "audit-collector"
    # mes-api (plant, site): mes-api for tests
    ip daddr 10.20.0.15/32 tcp dport 8443 accept comment "mes-api"
    ip6 daddr fd00:20::15/128 tcp dport 8443 accept comment "mes-api"
    counter log prefix "tortoise-network-deny " drop
  }
}
# Ingress: the instance listens on loopback only; no inbound rule is needed.
