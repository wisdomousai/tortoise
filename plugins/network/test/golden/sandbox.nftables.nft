#!/usr/sbin/nft -f
# Generated by `agent-native network export --format nftables`. Do not edit; regenerate.
# Policy a874c563fd1c4591 (sandbox, connected). Default: deny all egress except loopback and the rules below.
# NOT ENFORCED: vendor-api (api.vendor.example) has no addresses in the site policy; it stays blocked here.
# Applies to sockets owned by user "agent-native"; other users are unaffected.
table inet agent_native {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid != "agent-native" accept
    oif "lo" accept
    ct state established,related accept
    ip daddr 10.20.0.53 udp dport 53 accept comment "dns"
    ip daddr 10.20.0.53 tcp dport 53 accept comment "dns"
    # audit-collector (plant, site): audit-collector for tests
    ip daddr 10.20.0.40/32 tcp dport 6514 accept comment "audit-collector"
    # mes-api (plant, site): mes-api for tests
    ip daddr 10.20.0.15/32 tcp dport 8443 accept comment "mes-api"
    ip6 daddr fd00:20::15/128 tcp dport 8443 accept comment "mes-api"
    counter log prefix "agent-native-egress-deny " drop
  }
}
# Ingress: the authority listens on loopback only; no inbound rule is needed.
