# Generated by `tortoise network export --format systemd`. Do not edit; regenerate.
# Policy 7325a6cdf090f465 (sandbox, connected). Default: deny all outbound connections except loopback and the rules below.
# NOT ENFORCED: vendor-api (api.vendor.example) has no addresses in the deployment policy; it stays blocked here.
# IPAddressAllow restricts addresses, not ports; pair it with the nftables export for ports.
[Unit]
Description=tortoise local host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tortoise
Group=tortoise
ExecStart=/opt/tortoise/service serve --workspace /var/lib/tortoise/workspace --audit-log /var/lib/tortoise/audit --deployment-policy /etc/tortoise/deployment-policy.json
Restart=on-failure
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.20.0.53
IPAddressAllow=10.20.0.40/32
IPAddressAllow=10.20.0.15/32
IPAddressAllow=fd00:20::15/128
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Hides serial, HID and camera devices. For declared devices, remove it and add DeviceAllow=.
PrivateDevices=yes
ReadWritePaths=/var/lib/tortoise/workspace /var/lib/tortoise/audit
ReadOnlyPaths=/etc/tortoise/deployment-policy.json
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute is not set: the JavaScript JIT needs writable executable memory.

[Install]
WantedBy=multi-user.target
