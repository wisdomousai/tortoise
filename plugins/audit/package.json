{
  "name": "@tortoise/audit",
  "version": "0.1.0",
  "type": "module",
  "description": "Audit host plugin: the fail-closed, hash-chained event log with off-host forwarding, startup attestation, crash recovery and chain verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/audit"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/adapters": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/event-log": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/site": "workspace:*"
  }
}
