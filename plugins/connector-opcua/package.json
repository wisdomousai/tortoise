{
  "name": "@tortoise/connector-opcua",
  "version": "0.1.0",
  "type": "module",
  "description": "OPC UA connector: read-only observation of node values through the network port with a UA binary client (security policy None, anonymous), submitted as readings through an ingest command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "plugins/connector-opcua"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/contracts": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/kernel": "workspace:*",
    "@tortoise/observation": "workspace:*",
    "@tortoise/runtime": "workspace:*"
  }
}
