{
  "name": "agent-native-desktop-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/agent-native-desktop-starter.git"
  },
  "workspaces": [
    "packages/*",
    "workstations/*",
    "plugins/*",
    "apps/*",
    "examples/*",
    "samples/*",
    "sdks/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev-desktop.ts",
    "dev:web": "bun run build:web && bun apps/service/src/index.ts",
    "build": "bun run build:web && bun run build:registry && bun run build:registry:operator && bun run build:registry:compliance && bun run build:registry:native && bun run build:registry:driver",
    "build:web": "bun --bun vite build --config apps/web/vite.config.ts --logLevel warn",
    "build:web:examples": "bun scripts/build-web-examples.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json",
    "mobile:prepare": "bun scripts/mobile-entry.ts",
    "mobile:prebuild": "bun run mobile:prepare && cd apps/mobile && expo prebuild --clean --skip-dependency-update expo,react,react-native",
    "dev:mobile": "bun run mobile:prepare && cd apps/mobile && expo start --dev-client",
    "check:mobile-bundle": "AGENT_NATIVE_MOBILE_APPLICATION=./apps/mobile/fixture bun run mobile:prepare && cd apps/mobile && expo export --platform android --output-dir ../../dist/mobile-bundle-check",
    "test": "bun test",
    "test:unit": "bun test packages/contracts packages/runtime packages/client packages/react",
    "test:integration": "bun test packages/integration",
    "test:conformance": "bun test packages/testing packages/adapters examples samples",
    "test:service": "bun test packages/host plugins examples samples",
    "test:harness": "bun test packages/agents",
    "test:e2e": "playwright test",
    "test:scaffold": "bun test packages/scaffold",
    "test:package": "bun test apps/desktop",
    "generate": "bun scripts/generate.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:readmes": "bun scripts/check-readmes.ts",
    "check:skills": "bun scripts/check-skills.ts",
    "skills:link": "bun scripts/skills-link.ts",
    "skills:stamp": "bun scripts/skills-stamp.ts",
    "postinstall": "bun scripts/skills-link.ts --postinstall",
    "check:size": "bun scripts/check-size.ts",
    "docs:dev": "bun run generate && vitepress dev docs",
    "docs:build": "bun run generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:manifests": "bun scripts/check-manifests.ts",
    "check:framework": "bun packages/scaffold/src/cli.ts versions",
    "check": "bun run check:format && bun run typecheck && bun run check:boundaries && bun run check:manifests && bun run check:framework && bun run check:readmes && bun run check:skills && bun run check:size && bun run generate && bun run check:registry:operator && bun test && bun run test:portable && bun run test:sandbox && bun run build",
    "cli": "bun apps/service/src/cli.ts",
    "mcp": "bun packages/adapters/src/mcp.ts",
    "scaffold": "bun packages/scaffold/src/cli.ts",
    "package:stage": "bun scripts/package-stage.ts",
    "package:desktop": "bun scripts/package-desktop.ts",
    "test:scaffold:full": "SCAFFOLD_ACCEPTANCE=1 bun test packages/scaffold",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "build:registry": "shadcn build registry.json --output ../../dist/registry --cwd packages/frame",
    "build:cli": "bun scripts/build-cli.ts",
    "bundle": "bun scripts/bundle.ts",
    "test:portable": "bun test --preload ./packages/kernel/test/without-web-globals.ts packages/kernel packages/runtime packages/client packages/integration packages/mobile",
    "test:sandbox": "SANDBOX_BINARY=1 bun test examples/quality-inspection/test/sandbox.test.ts",
    "test:execution-host:linux": "bun scripts/test-execution-host-linux.ts",
    "test:isolated": "bun test --preload ./scripts/isolated-preload.ts",
    "build:registry:operator": "bun scripts/build-operator-registry.ts && shadcn build registry.json --output ../../dist/registry/operator --cwd packages/operator-ui",
    "build:registry:compliance": "shadcn build registry.json --output ../../dist/registry/compliance --cwd plugins/compliance",
    "build:registry:native": "shadcn build registry.json --output ../../dist/registry/native --cwd packages/frame-native",
    "build:registry:driver": "shadcn build registry.json --output ../../dist/registry/driver --cwd plugins/connector-driver",
    "check:registry:operator": "bun scripts/build-operator-registry.ts --check",
    "changeset": "changeset",
    "release:version": "changeset version && bun install",
    "release:pack": "bun scripts/release.ts pack",
    "release:serve": "bun scripts/release.ts serve",
    "release:publish": "bun scripts/release.ts publish"
  },
  "dependencies": {
    "@agent-native/adapters": "workspace:*",
    "@agent-native/agents": "workspace:*",
    "@agent-native/android-intents": "workspace:*",
    "@agent-native/asset-survey": "workspace:*",
