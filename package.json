{
  "name": "agent-native-desktop-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev-desktop.ts",
    "dev:web": "bun run build:web && bun apps/service/src/index.ts",
    "build": "bun run build:web && bun run build:registry && bun run build:registry:operator",
    "build:web": "bun --bun vite build --config apps/web/vite.config.ts --logLevel warn",
    "build:web:examples": "bun scripts/build-web-examples.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test packages/contracts packages/runtime packages/client packages/react",
    "test:integration": "bun test packages/integration",
    "test:conformance": "bun test packages/testing packages/adapters examples",
    "test:service": "bun test packages/host examples",
    "test:harness": "bun test packages/agents",
    "test:e2e": "playwright test",
    "test:scaffold": "bun test packages/scaffold",
    "test:package": "bun test apps/desktop",
    "generate": "bun scripts/generate.ts",
    "check:generated": "bun scripts/generate.ts --check",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:readmes": "bun scripts/check-readmes.ts",
    "check:size": "bun scripts/check-size.ts",
    "check": "bun run check:format && bun run typecheck && bun run check:boundaries && bun run check:readmes && bun run check:size && bun run check:generated && bun run check:registry:operator && bun test && bun run test:sandbox && bun run build",
    "cli": "bun apps/service/src/cli.ts",
    "mcp": "bun packages/adapters/src/mcp.ts",
    "scaffold": "bun packages/scaffold/src/cli.ts",
    "package:stage": "bun scripts/package-stage.ts",
    "package:desktop": "bun scripts/package-desktop.ts",
    "test:scaffold:full": "SCAFFOLD_ACCEPTANCE=1 bun test packages/scaffold",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "build:registry": "shadcn build registry.json --output ../../dist/registry --cwd packages/frame",
    "build:cli": "bun scripts/build-cli.ts",
    "test:sandbox": "SANDBOX_BINARY=1 bun test examples/quality-inspection/test/sandbox.test.ts",
    "test:isolated": "bun test --preload ./scripts/isolated-preload.ts",
    "build:registry:operator": "bun scripts/build-operator-registry.ts && shadcn build registry.json --output ../../dist/registry/operator --cwd packages/operator-ui",
    "check:registry:operator": "bun scripts/build-operator-registry.ts --check"
  },
  "dependencies": {
    "@agent-native/adapters": "workspace:*",
    "@agent-native/agents": "workspace:*",
    "@agent-native/assurance": "workspace:*",
    "@agent-native/client": "workspace:*",
    "@agent-native/contracts": "workspace:*",
    "@agent-native/crm-capture": "workspace:*",
    "@agent-native/devices": "workspace:*",
    "@agent-native/egress": "workspace:*",
    "@agent-native/event-log": "workspace:*",
    "@agent-native/frame": "workspace:*",
    "@agent-native/host": "workspace:*",
    "@agent-native/integration": "workspace:*",
    "@agent-native/line-station": "workspace:*",
    "@agent-native/operator-ui": "workspace:*",
    "@agent-native/project-tasks": "workspace:*",
    "@agent-native/quality-inspection": "workspace:*",
    "@agent-native/react": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@agent-native/scaffold": "workspace:*",
    "@agent-native/station": "workspace:*",
    "@agent-native/testing": "workspace:*",
    "@ai-sdk/openai": "4.0.86",
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@casl/ability": "7.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.6",
    "ai": "7.0.130",
    "bwip-js": "4.11.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "shadcn": "4.21.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "trustedDependencies": [
    "electron"
  ]
}
