{
  "name": "agent-native-desktop-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run build:web && bun apps/service/src/index.ts",
    "build": "bun run build:web",
    "build:web": "bun scripts/build-web.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test packages/contracts packages/runtime packages/client packages/react",
    "test:conformance": "bun test packages/testing packages/adapters examples",
    "test:service": "bun test apps/service",
    "test:harness": "bun test packages/agents",
    "test:e2e": "playwright test",
    "test:scaffold": "bun test packages/scaffold",
    "test:package": "bun test apps/desktop",
    "generate": "bun scripts/generate.ts",
    "check:generated": "bun scripts/generate.ts --check",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check": "bun run check:format && bun run typecheck && bun run check:boundaries && bun run check:generated && bun test && bun run build",
    "cli": "bun packages/adapters/src/cli.ts",
    "mcp": "bun packages/adapters/src/mcp.ts",
    "scaffold": "bun packages/scaffold/src/index.ts",
    "package:stage": "bun scripts/package-stage.ts",
    "package:desktop": "bun scripts/package-desktop.ts",
    "test:scaffold:full": "SCAFFOLD_ACCEPTANCE=1 bun test packages/scaffold",
    "job": "bun scripts/job.ts",
    "format": "prettier --write .",
    "check:format": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@ai-sdk/openai": "4.0.86",
    "@casl/ability": "7.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.0",
    "ai": "7.0.130",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "@agent-native/contracts": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@agent-native/client": "workspace:*",
    "@agent-native/react": "workspace:*",
    "@agent-native/adapters": "workspace:*",
    "@agent-native/agents": "workspace:*",
    "@agent-native/testing": "workspace:*",
    "@agent-native/scaffold": "workspace:*",
    "@agent-native/project-tasks": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "@types/node": "26.6.4",
    "prettier": "3.9.9"
  },
  "trustedDependencies": [
    "electron"
  ]
}
