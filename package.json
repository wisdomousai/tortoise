    "@agent-native/frame": "workspace:*",
    "@agent-native/frame-native": "workspace:*",
    "@agent-native/host": "workspace:*",
    "@agent-native/hub-link": "workspace:*",
    "@agent-native/integration": "workspace:*",
    "@agent-native/intent-scanner": "workspace:*",
    "@agent-native/kernel": "workspace:*",
    "@agent-native/line-station": "workspace:*",
    "@agent-native/managed-config": "workspace:*",
    "@agent-native/mobile": "workspace:*",
    "@agent-native/model-server": "workspace:*",
    "@agent-native/network": "workspace:*",
    "@agent-native/notifications": "workspace:*",
    "@agent-native/observation": "workspace:*",
    "@agent-native/operator-ui": "workspace:*",
    "@agent-native/os": "workspace:*",
    "@agent-native/os-shortcuts": "workspace:*",
    "@agent-native/peer-link": "workspace:*",
    "@agent-native/process": "workspace:*",
    "@agent-native/project-tasks": "workspace:*",
    "@agent-native/quality-inspection": "workspace:*",
    "@agent-native/react": "workspace:*",
    "@agent-native/receiving": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@agent-native/sample-lab-requests": "workspace:*",
    "@agent-native/sample-lab-requests-agents": "workspace:*",
    "@agent-native/sample-lab-requests-host-plugin": "workspace:*",
    "@agent-native/sample-lab-requests-operations": "workspace:*",
    "@agent-native/sample-lab-requests-review": "workspace:*",
    "@agent-native/sample-lab-requests-signals": "workspace:*",
