{
  "name": "@tortoise/screen-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Screen bridge to a workstation application that has no API and must stay unmodified: profiles, observer, gated controller and recognition adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "workstations/screen-bridge"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@tortoise/contracts": "workspace:*",
    "@tortoise/integration": "workspace:*",
    "@tortoise/observation": "workspace:*",
    "@tortoise/runtime": "workspace:*",
    "zod": "4.6.5"
  }
}
