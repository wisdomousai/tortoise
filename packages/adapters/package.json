{
  "name": "@agent-native/adapters",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/youtiger/agent-native-desktop-starter.git",
    "directory": "packages/adapters"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@agent-native/client": "workspace:*",
    "@agent-native/contracts": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@casl/ability": "7.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
