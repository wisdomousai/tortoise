{
  "name": "@tortoise/frame",
  "version": "0.1.0",
  "type": "module",
  "description": "Web frame for one application (session, routing, palette, run panel), distributed as a shadcn registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "packages/frame"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    "./screens": "./src/screens.ts",
    "./feature-screens": "./src/feature-screens.ts",
    "./plugin-screens": "./src/plugin-screens.ts",
    "./vite": "./vite.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.6",
    "@tortoise/client": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/host": "workspace:*",
    "@tortoise/operator-ui": "workspace:*",
    "@tortoise/react": "workspace:*",
    "@tortoise/shell": "workspace:*",
    "lucide-react": "1.52.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "vite": "8.3.3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
