{
  "name": "@agent-native/mobile",
  "version": "0.1.0",
  "type": "module",
  "description": "The mobile host platform: workspace ownership, snapshot storage and blobs on Android and iOS, and an embedded authority for the app's screens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/youtiger/agent-native-desktop-starter.git",
    "directory": "packages/mobile"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./expo": "./src/expo/index.ts",
    "./intent-filters": "./intent-filters.plugin.cjs",
    "./shortcuts": "./shortcuts.plugin.cjs"
  },
  "dependencies": {
    "@agent-native/adapters": "workspace:*",
    "@agent-native/contracts": "workspace:*",
    "@agent-native/kernel": "workspace:*",
    "@agent-native/runtime": "workspace:*",
    "@agent-native/shell": "workspace:*"
  },
  "peerDependencies": {
    "expo": "58.0.14",
    "expo-background-task": "58.0.11",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.9",
    "expo-modules-core": "58.0.22",
    "expo-notifications": "58.1.5",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.19",
    "expo-sqlite": "58.0.13",
    "expo-task-manager": "58.0.12",
    "react-native": "0.88.0"
  }
}
