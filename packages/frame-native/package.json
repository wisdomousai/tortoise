{
  "name": "@tortoise/frame-native",
  "version": "0.1.0",
  "type": "module",
  "description": "Native frame for one application on Android and iOS (navigation, session, live invalidation) and glove-sized components, distributed as a shadcn registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisdomousai/tortoise.git",
    "directory": "packages/frame-native"
  },
  "files": [
    "**/*",
    "!test/**",
    "!scripts/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "exports": {
    "./screens": "./src/screens.ts",
    "./feature-screens": "./src/feature-screens.ts",
    "./plugin-screens": "./src/plugin-screens.ts",
    "./frame": "./src/frame.tsx",
    "./session": "./src/session.tsx",
    "./os-actions": "./src/os-actions.tsx",
    "./os-deliveries": "./src/os-deliveries.tsx",
    "./os-provenance": "./src/os-provenance.tsx",
    "./components/*": "./src/components/*.tsx",
    "./theme.css": "./src/styles/theme.css"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.1",
    "@tortoise/client": "workspace:*",
    "@tortoise/contracts": "workspace:*",
    "@tortoise/react": "workspace:*",
    "@tortoise/shell": "workspace:*",
    "lucide-react-native": "1.59.0",
    "uniwind": "1.12.2"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1"
  }
}
