{
  "format": 1,
  "application": "quality-inspection",
  "owners": [
    {
      "id": "anthropic",
      "kind": "component",
      "description": "Claude Agent SDK harness with API-key funding."
    },
    {
      "id": "audit",
      "kind": "component",
      "description": "Audit plugin: forwards audit events off the host as RFC 5424 syslog."
    },
    {
      "id": "authority",
      "kind": "component",
      "description": "Local authority service: HTTP/SSE API and MCP attach."
    },
    {
      "id": "compliance",
      "kind": "module"
    },
    {
      "id": "openai",
      "kind": "component",
      "description": "ChatGPT plan sign-in, model catalog, Codex app-server and AI SDK inference."
    },
    {
      "id": "quality-inspection",
      "kind": "module"
    }
  ],
  "network": [
    {
      "availability": "optional",
      "dataClasses": [
        "prompt",
        "application-context",
        "tool-results"
      ],
      "direction": "egress",
      "host": "api.anthropic.com",
      "id": "anthropic-api",
      "offline": "unavailable",
      "owner": "anthropic",
      "protocol": "https",
      "purpose": "Inference for Claude runs.",
      "scope": "internet"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "audit-event"
      ],
      "direction": "egress",
      "id": "audit-collector",
      "offline": "degrade",
      "owner": "audit",
      "protocol": "tcp",
      "purpose": "Forward audit events off the host (RFC 5424 syslog over TLS).",
      "scope": "site"
    },
    {
      "availability": "required",
      "dataClasses": [],
      "direction": "ingress",
      "id": "authority-http",
      "owner": "authority",
      "protocol": "http",
      "purpose": "Serve the frontend, API, events and attach connections.",
      "scope": "loopback"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "prompt",
        "application-context",
        "tool-results"
      ],
      "direction": "egress",
      "host": "api.openai.com",
      "id": "openai-api",
      "offline": "unavailable",
      "owner": "openai",
      "protocol": "https",
      "purpose": "Model catalog and inference for Codex and AI SDK runs.",
      "scope": "internet"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "oauth-authorization",
        "identity-token"
      ],
      "direction": "egress",
      "host": "auth.openai.com",
      "id": "openai-auth",
      "offline": "unavailable",
      "owner": "openai",
      "protocol": "https",
      "purpose": "ChatGPT sign-in: token exchange, OIDC discovery, signing keys and revocation.",
      "scope": "internet"
    },
    {
      "availability": "required",
      "dataClasses": [
        "inspection-result",
        "defect",
        "usage-decision"
      ],
      "direction": "egress",
      "id": "quality-system-api",
      "offline": "queue",
      "owner": "quality-inspection",
      "protocol": "https",
      "purpose": "Forward results, defects and usage decisions to the quality system and pull lots and characteristics from it.",
      "scope": "site",
      "targets": [
        "quality-system"
      ]
    }
  ],
  "devices": [],
  "processes": [
    {
      "availability": "optional",
      "executable": "claude",
      "id": "claude-code",
      "network": [
        "anthropic-api"
      ],
      "owner": "anthropic",
      "purpose": "Claude Code process driven by the Agent SDK."
    },
    {
      "availability": "optional",
      "executable": "codex",
      "id": "codex-app-server",
      "network": [
        "openai-api"
      ],
      "owner": "openai",
      "purpose": "Codex app-server harness under a delegated grant."
    }
  ],
  "flows": [
    {
      "operation": "inspection.decision.set",
      "kind": "command",
      "module": "quality-inspection",
      "target": "quality-system",
      "path": "outbox",
      "destinations": [
        "quality-system-api"
      ],
      "dataClasses": [
        "defect",
        "inspection-result",
        "usage-decision"
      ],
      "auditFields": []
    },
    {
      "operation": "inspection.defect.record",
      "kind": "command",
      "module": "quality-inspection",
      "target": "quality-system",
      "path": "outbox",
      "destinations": [
        "quality-system-api"
      ],
      "dataClasses": [
        "defect",
        "inspection-result",
        "usage-decision"
      ],
      "auditFields": []
    },
    {
      "operation": "inspection.result.correct",
      "kind": "command",
      "module": "quality-inspection",
      "target": "quality-system",
      "path": "outbox",
      "destinations": [
        "quality-system-api"
      ],
      "dataClasses": [
        "defect",
        "inspection-result",
        "usage-decision"
      ],
      "auditFields": []
    },
    {
      "operation": "inspection.result.record",
      "kind": "command",
      "module": "quality-inspection",
      "target": "quality-system",
      "path": "outbox",
      "destinations": [
        "quality-system-api"
      ],
      "dataClasses": [
        "defect",
        "inspection-result",
        "usage-decision"
      ],
      "auditFields": []
    },
    {
      "operation": "inspection.result.record-batch",
      "kind": "command",
      "module": "quality-inspection",
      "target": "quality-system",
      "path": "outbox",
      "destinations": [
        "quality-system-api"
      ],
      "dataClasses": [
        "defect",
        "inspection-result",
        "usage-decision"
      ],
      "auditFields": []
    }
  ],
  "os": {
    "handlers": [],
    "actions": [
      {
        "id": "openai.authorize",
        "owner": "openai",
        "kind": "open",
        "reaches": "https://auth.openai.com/api/accounts/authorize",
        "dataClasses": [
          "oauth-authorization"
        ]
      }
    ]
  },
  "summary": {
    "egress": 5,
    "ingress": 1,
    "internet": [
      "anthropic-api",
      "openai-api",
      "openai-auth"
    ],
    "site": [
      "audit-collector",
      "quality-system-api"
    ],
    "required": [
      "authority-http",
      "quality-system-api"
    ],
    "dataClasses": [
      "application-context",
      "audit-event",
      "defect",
      "identity-token",
      "inspection-result",
      "oauth-authorization",
      "prompt",
      "tool-results",
      "usage-decision"
    ]
  }
}
