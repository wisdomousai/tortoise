{
  "format": 1,
  "application": "crm-capture",
  "owners": [
    {
      "id": "anthropic",
      "kind": "component",
      "description": "Claude Agent SDK harness with API-key funding."
    },
    {
      "id": "audit",
      "kind": "component",
      "description": "Audit plugin: forwards audit events off the host as RFC 5424 syslog."
    },
    {
      "id": "authority",
      "kind": "component",
      "description": "Local authority service: HTTP/SSE API and MCP attach."
    },
    {
      "id": "compliance",
      "kind": "module"
    },
    {
      "id": "crm-capture",
      "kind": "module"
    },
    {
      "id": "local-inference",
      "kind": "component",
      "description": "OpenAI-compatible model server on this host (llama.cpp, Ollama, vLLM)."
    },
    {
      "id": "openai",
      "kind": "component",
      "description": "ChatGPT plan sign-in, model catalog, Codex app-server and AI SDK inference."
    }
  ],
  "network": [
    {
      "availability": "optional",
      "dataClasses": [
        "prompt",
        "application-context",
        "tool-results"
      ],
      "direction": "egress",
      "host": "api.anthropic.com",
      "id": "anthropic-api",
      "offline": "unavailable",
      "owner": "anthropic",
      "protocol": "https",
      "purpose": "Inference for Claude runs.",
      "scope": "internet"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "audit-event"
      ],
      "direction": "egress",
      "id": "audit-collector",
      "offline": "degrade",
      "owner": "audit",
      "protocol": "tcp",
      "purpose": "Forward audit events off the host (RFC 5424 syslog over TLS).",
      "scope": "site"
    },
    {
      "availability": "required",
      "dataClasses": [],
      "direction": "ingress",
      "id": "authority-http",
      "owner": "authority",
      "protocol": "http",
      "purpose": "Serve the frontend, API, events and attach connections.",
      "scope": "loopback"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "crm-search-query",
        "crm-account",
        "crm-activity"
      ],
      "direction": "egress",
      "id": "crm-api",
      "offline": "queue",
      "owner": "crm-capture",
      "protocol": "https",
      "purpose": "Search accounts and contacts live with the caller’s CRM access, follow adopted accounts, forward logged activities and pull followed accounts.",
      "reads": [
        "crm"
      ],
      "scope": "internet",
      "targets": [
        "crm"
      ]
    },
    {
      "availability": "optional",
      "dataClasses": [
        "prompt",
        "application-context",
        "tool-results"
      ],
      "direction": "egress",
      "id": "local-inference",
      "offline": "unavailable",
      "owner": "local-inference",
      "protocol": "http",
      "purpose": "Inference for agents that require a local model. Prompts stay on this host.",
      "scope": "loopback"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "prompt",
        "application-context",
        "tool-results"
      ],
      "direction": "egress",
      "host": "api.openai.com",
      "id": "openai-api",
      "offline": "unavailable",
      "owner": "openai",
      "protocol": "https",
      "purpose": "Model catalog and inference for Codex and AI SDK runs.",
      "scope": "internet"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "oauth-authorization",
        "identity-token"
      ],
      "direction": "egress",
      "host": "auth.openai.com",
      "id": "openai-auth",
      "offline": "unavailable",
      "owner": "openai",
      "protocol": "https",
      "purpose": "ChatGPT sign-in: token exchange, OIDC discovery, signing keys and revocation.",
      "scope": "internet"
    }
  ],
  "devices": [],
  "processes": [
    {
      "availability": "optional",
      "executable": "claude",
      "id": "claude-code",
      "network": [
        "anthropic-api"
      ],
      "owner": "anthropic",
      "purpose": "Claude Code process driven by the Agent SDK."
    },
    {
      "availability": "optional",
      "executable": "codex",
      "id": "codex-app-server",
      "network": [
        "openai-api"
      ],
      "owner": "openai",
      "purpose": "Codex app-server harness under a delegated grant."
    }
  ],
