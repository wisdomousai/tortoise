      "purpose": "Inference for Claude runs.",
      "scope": "internet"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "audit-event"
      ],
      "direction": "egress",
      "id": "audit-collector",
      "offline": "degrade",
      "owner": "authority",
      "protocol": "tcp",
