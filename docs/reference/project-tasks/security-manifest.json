      "scope": "site"
    },
    {
      "availability": "required",
      "dataClasses": [],
      "direction": "ingress",
      "id": "authority-http",
      "owner": "authority",
      "protocol": "http",
      "purpose": "Serve the frontend, API, events and attach connections.",
      "scope": "loopback"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "prompt",
        "application-context",
        "tool-results"
      ],
      "direction": "egress",
      "host": "api.openai.com",
      "id": "openai-api",
      "offline": "unavailable",
      "owner": "openai",
      "protocol": "https",
      "purpose": "Model catalog and inference for Codex and AI SDK runs.",
      "scope": "internet"
    },
    {
      "availability": "optional",
      "dataClasses": [
        "oauth-authorization",
        "identity-token"
      ],
      "direction": "egress",
      "host": "auth.openai.com",
      "id": "openai-auth",
      "offline": "unavailable",
      "owner": "openai",
      "protocol": "https",
      "purpose": "ChatGPT sign-in: token exchange, OIDC discovery, signing keys and revocation.",
      "scope": "internet"
    }
