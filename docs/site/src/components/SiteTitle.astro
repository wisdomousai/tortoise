---
// The tortoise before the site title, at the height of the top bar.
import Tortoise from './Tortoise.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <Tortoise class="nav-tortoise" />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .site-title :global(.nav-tortoise) {
    width: 44px;
  }
</style>
