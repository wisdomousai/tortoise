{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./apps/web/src/*", "./packages/frame/src/*", "./packages/operator-ui/src/*"]
    }
  },
  "include": [
    "packages",
    "plugins",
    "apps",
    "examples",
    "sdks",
    "scripts",
    "tests",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "apps/mobile/index.ts",
    "apps/mobile/src",
    "apps/mobile/fixture/screens-native.tsx",
    "apps/mobile/generated",
    "packages/mobile/src/expo",
    "packages/frame-native/src/frame.tsx",
    "packages/frame-native/src/session.tsx",
    "packages/frame-native/src/components",
    "packages/frame-native/src/os-provenance.tsx",
    "packages/frame-native/src/native-env.d.ts",
    "plugins/*/src/expo"
  ]
}
