node_modules/
dist/
artifacts/
test-results/
playwright-report/
.workspace/
*.sqlite
*.sqlite-*
.env
.env.*
!.env.example
.DS_Store

# Expo continuous native generation: native projects and caches are regenerated, never committed.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/
apps/mobile/generated/

# Coding-agent skill links, written by `bun run skills:link`.
.claude/skills/
.agents/skills/

# The root LICENSE, copied into a package only while it is packed
packages/*/LICENSE
plugins/*/LICENSE

# Solution files an IDE writes when it opens the repo root; each .NET workspace keeps its own .slnx
/*.sln
/*.slnx

# VitePress cache, written by `bun run docs:dev`.
docs/.vitepress/cache/
