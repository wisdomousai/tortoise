{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": false
  },
  "include": [
    "apps/mobile/index.ts",
    "apps/mobile/src",
    "apps/mobile/fixture",
    "packages/contracts/src",
    "packages/runtime/src",
    "packages/client/src/client.ts",
    "packages/client/src/live-query.ts",
    "packages/client/src/types.ts",
    "packages/integration/src",
    "packages/kernel/src",
    "packages/adapters/src/application-port.ts",
    "packages/adapters/src/direct-transport.ts",
    "packages/adapters/src/sql-driver.ts",
    "packages/adapters/src/snapshot-storage.ts",
    "packages/adapters/src/exclusive-lock.ts",
    "packages/mobile/src",
    "packages/frame-native/src",
    "packages/shell/src",
    "packages/devices/src/scanner/decode.ts",
    "packages/devices/src/scanner/profile.ts",
    "packages/devices/src/scanner/source.ts",
    "plugins/hub-link/src",
    "plugins/intent-scanner/src",
    "plugins/managed-config/src",
    "packages/react/src/query.ts",
    "packages/react/src/query",
    "packages/event-log/src/chain.ts",
    "packages/event-log/src/memory.ts",
    "packages/event-log/src/forward.ts"
  ],
  "exclude": ["node_modules", "dist", "artifacts", "**/*.test.ts", "**/test"]
}
